#!name = Soul（精简版）
#!desc = 仅保留：私聊阅后即焚、个人主页tab、个人主页数量提示、去除私聊限制
#!author = 树先生, 可莉, 奶思, 怎么肥事
#!icon = https://github.com/ishowshu/loon/raw/refs/heads/main/icon/soul.png
#!date = 2026-08-28

[Argument]
picRead = switch,true,tag=阅后即焚,desc=开启/关闭功能
chatPri = switch,true,tag=私聊免礼,desc=开启/关闭功能
vist = switch,true,tag=主页访问数量提示,desc=开启/关闭功能

[Script]
http-response ^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul.js, requires-body=true, tag=私聊阅后即焚, enable={picRead}
http-response ^https:\/\/post\.soulapp\.cn\/homepage\/tabs\/v2 script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul.js, requires-body=true, tag=个人主页tab
http-response ^https:\/\/api-user\.soulapp\.cn\/user\/homepage\/metrics script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul.js, requires-body=true, tag=个人主页数量提示, enable={vist}
http-response ^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul.js, requires-body=true, tag=去除私聊限制, enable={chatPri}

[MitM]
hostname = api-chat.soulapp.cn, post.soulapp.cn, api-user.soulapp.cn
