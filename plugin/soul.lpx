#!name = Soul精简模块
#!desc = 仅保留：私聊阅后即焚｜派对频道列表｜星球页面按钮
#!author = 树先生, 可莉, 奶思, 怎么肥事
#!icon = https://github.com/ishowshu/loon/raw/refs/heads/main/icon/soul.png
#!date = 2026-08-27 17:20

[Argument]
# 星球页面按钮开关
soulMatch = switch,true,tag=星球：灵魂匹配,desc=显示/隐藏按钮
voiceMatch = switch,true,tag=星球：语音匹配,desc=显示/隐藏按钮
partyMatch = switch,true,tag=星球：派对,desc=显示/隐藏按钮
masked = switch,true,tag=星球：蒙面酒馆,desc=显示/隐藏按钮
maskedMatch = switch,true,tag=星球：蒙面匹配,desc=显示/隐藏按钮
planet = switch,true,tag=星球：星球实验室/兴趣群组,desc=显示/隐藏按钮

# 派对频道分类开关
hot = switch,true,tag=派对分类：今日Hot,desc=显示/隐藏按钮
all = switch,true,tag=派对分类：全部派对,desc=显示/隐藏按钮
emotion = switch,true,tag=派对分类：情感树洞,desc=显示/隐藏按钮
personal = switch,true,tag=派对分类：个人成长,desc=显示/隐藏按钮
play = switch,true,tag=派对分类：玩法专区,desc=显示/隐藏按钮
interest = switch,true,tag=派对分类：兴趣交流,desc=显示/隐藏按钮
argue = switch,true,tag=派对分类：趣味讨论,desc=显示/隐藏按钮
story = switch,true,tag=派对分类：情感故事,desc=显示/隐藏按钮
chat = switch,true,tag=派对分类：闲聊唠嗑,desc=显示/隐藏按钮
heart = switch,true,tag=派对分类：心动速配,desc=显示/隐藏按钮

# 阅后即焚开关
picRead = switch,true,tag=阅后即焚,desc=开启/关闭功能

[Rewrite]

[Script]
# 星球页面按钮
http-response ^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul.js, requires-body=true, tag=星球页面按钮, argument=[{soulMatch}, {voiceMatch}, {partyMatch}, {masked}, {maskedMatch}, {planet}]
# 派对频道列表
http-response ^https:\/\/chat-live\.soulapp\.cn\/chatroom\/getRoomTagInfo script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul.js, requires-body=true, tag=派对频道列表, argument=[{hot}, {all}, {emotion}, {personal}, {play}, {interest} , {argue}, {story}, {chat}, {heart}]
# 私聊阅后即焚
http-response ^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul.js, requires-body=true, tag=私聊阅后即焚, enable={picRead}

[MitM]
hostname = api-user.soulapp.cn,chat-live.soulapp.cn,api-chat.soulapp.cn
