#!name = Soul
#!desc = 移除广告和精简页面（修复Soul Scheme聊天房间跳转冲突｜删除星球按钮、派对频道列表、派对中间横幅、派对猜你喜欢）
#!author = 树先生, 可莉, 奶思, 怎么肥事
#!icon = https://github.com/ishowshu/loon/raw/refs/heads/main/icon/soul.png
#!date = 2026-08-28 10:40

[Argument]
picRead = switch,true,tag=阅后即焚,desc=开启/关闭功能
chatPri = switch,true,tag=私聊免礼,desc=开启/关闭功能
vist = switch,true,tag=主页访问数量提示,desc=开启/关闭功能

[Rewrite]
# 广告下发
^https:\/\/ssp\.soulapp\.cn\/api\/q reject-dict
^https:\/\/47\.110\.187\.87\/winterfell\/(?:v2\/)?getIpByDomain reject-dict
# 主页瞬间指导
^https:\/\/post\.soulapp\.cn\/v\d\/post\/homepage\/guide\/card reject-dict
# 去除青少年弹窗
^https:\/\/api-account\.soulapp\.cn\/teenager\/config reject-dict
# 谁看过我横幅广告
^https:\/\/api-a\.soulapp\.cn\/official\/scene\/module reject-dict
# 主页右下角悬浮广告
^https:\/\/api-user\.soulapp\.cn\/furion\/position\/content reject-dict
# 拒绝收集用户数据
^https:\/\/data-collector\.soulapp\.cn\/api\/data\/report\/v2 reject-dict
# 去除聊天界面再遇见
^https:\/\/api-chat\.soulapp\.cn\/chat\/entrance\/first reject
# 去除通讯录右下角机器人图标
^https:\/\/api-chat\.soulapp\.cn\/addressBook\/showBubblingEnter reject
# 去除首次私聊打开去除顶部聊天信息卡片
^https:\/\/api-user\.soulapp\.cn\/user\/matchRelation\/getChatCard reject
# 去除表情推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/interact\/getEmojiList reject
# 去除我的页面soul币活动推荐
^https:\/\/increase-openapi\.soulapp\.cn\/increase\/fission\/getHomePageRedIcon reject
# 去除首次私聊打开星球交汇小卡片
^https:\/\/api-chat\.soulapp\.cn\/similar\/post\/intersect\/trigger reject
# 去除首次打开私聊界面底部瞬间表情推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/guide\/defaultWord reject
# 去除聊天输入文字时的gif表情推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/emoji\/recommend reject
# 去除私聊瞬间小横幅
^https:\/\/api-a\.soulapp\.cn\/shara\/app\/url reject
# 私聊快捷菜单
^https:\/\/api-chat\.soulapp\.cn\/chat\/quick\/menu reject
# 私聊用户匹配推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/session\/quickButtonCheck reject-dict

[Script]
# 去除私聊限制
http-response ^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul.js, requires-body=true, tag=去除私聊限制, enable={chatPri}
# 个人主页数量提示
http-response ^https:\/\/api-user\.soulapp\.cn\/user\/homepage\/metrics script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul.js, requires-body=true, tag=个人主页数量提示, enable={vist}
# 个人主页tab
http-response ^https:\/\/post\.soulapp\.cn\/homepage\/tabs\/v2 script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul.js, requires-body=true, tag=个人主页tab
# 私聊阅后即焚
http-response ^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul.js, requires-body=true, tag=私聊阅后即焚, enable={picRead}

[MitM]
hostname = ssp.soulapp.cn, increase-openapi.soulapp.cn, data-collector.soulapp.cn, post.soulapp.cn, api-account.soulapp.cn, api-a.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-user.soulapp.cn, api-chat.soulapp.cn, 47.98.137.249, 47.110.187.87
